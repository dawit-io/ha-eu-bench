# Copy to .env (ignored by git) and fill in the provider you use, then `source env.sh`.
# Use a project dedicated to these experiments on every provider: nothing else in it, nothing to break.

# Hetzner: Cloud Console, project, Security, API tokens. Permission "Read & Write".
HCLOUD_TOKEN=

# Scaleway: an IAM API key. The project is the key's default project unless you set one.
SCW_ACCESS_KEY=
SCW_SECRET_KEY=
SCW_DEFAULT_PROJECT_ID=

# OVHcloud: a Public Cloud user (Users & Roles). The project is found from the user when it sees exactly one.
OS_USERNAME=
OS_PASSWORD=
OS_PROJECT_ID=

# AWS: an IAM user with AmazonEC2FullAccess only, and an access key for "Command Line Interface".
# Milan (eu-south-1) is an opt-in region: enable it in the account before the first apply.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-south-1
